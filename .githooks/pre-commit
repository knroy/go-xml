#!/bin/sh
# Refuse a commit authored by anyone but the repository owner.
#
# Commits here are the owner's alone, which is also why no attribution
# trailer is ever added. That held until an agent working in a worktree
# committed five changes under an address that appears nowhere in any git
# config -- global, local, or worktree -- so it must have passed
# -c user.email= or --author on the command line. Nothing noticed until the
# commits were already pushed, and correcting them meant rewriting published
# history and force-pushing.
#
# A configured identity is therefore not enough on its own: it is the default,
# and a default is exactly what an explicit flag overrides. This checks the
# value git has actually resolved for THIS commit, after every override has
# been applied, which is the only point at which the answer is known.
#
# GOXML_ALLOW_AUTHOR=1 bypasses it for a deliberate rebase or a cherry-pick
# that must keep its original author.

[ "$GOXML_ALLOW_AUTHOR" = "1" ] && exit 0

owner='rax.komol@gmail.com'
author=$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')
committer=$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')

for who in "$author" "$committer"; do
	if [ "$who" != "$owner" ]; then
		echo "pre-commit: refusing a commit by <$who>." >&2
		echo "  This repository's commits are $owner alone." >&2
		echo "  Set user.email, or export GOXML_ALLOW_AUTHOR=1 if this is" >&2
		echo "  a rebase or cherry-pick that must keep its original author." >&2
		exit 1
	fi
done
